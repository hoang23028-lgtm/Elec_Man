APP_ENV=development
APP_NAME=Hệ thống AI quản lý đồng hồ điện
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost
ENFORCE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=80
# Import the explicitly approved public snapshot only when the database is empty.
IMPORT_SHARED_DATA=true
POSTGRES_DB=electric_meter_ai
POSTGRES_USER=electric_meter_app
POSTGRES_PASSWORD=change-me-before-deployment
DATABASE_URL=postgresql+psycopg://electric_meter_app:change-me-before-deployment@postgres:5432/electric_meter_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
STORAGE_ROOT=/data/electric-meter-ai
MODELS_ROOT=/models
WORKER_POLL_INTERVAL_SECONDS=0.5
PPOCR_READER_URL=http://reader-ppocr:8080
PARSEQ_READER_URL=http://reader-parseq:8080
SEQUENCE_READER_TIMEOUT_SECONDS=15
METER_INTEGER_DIGITS_DEFAULT=5
TRAINER_CPUS=1.0
TRAINER_MEMORY_LIMIT=2g
TRAINING_TIMEOUT_SECONDS=7200
MAX_RETRY_COUNT=3
JOB_STUCK_TIMEOUT_SECONDS=900
MAX_IMAGE_SIZE_MB=20
MAX_IMAGE_PIXELS=40000000

# Authentication: generate unique high-entropy values before deployment.
SESSION_COOKIE_NAME=ema_session
SESSION_TTL_HOURS=8
SESSION_SECRET=replace-with-a-64-character-random-secret-before-production
# Used once by the initialization command; remove from the environment afterwards.
ADMIN_INITIAL_PASSWORD=
