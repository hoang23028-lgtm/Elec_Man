FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=1 HOME=/opt/model-cache
WORKDIR /app
ADD --checksum=sha256:f57289cb1fc7fe41f488a52ea48f8a7f114252ef405b0b64efc1d528c29b48ef \
    https://github.com/baudm/parseq/archive/1902db043c029a7e03a3818c616c06600af574be.tar.gz \
    /tmp/parseq.tar.gz
RUN mkdir -p /opt/parseq /opt/model-cache \
    && tar -xzf /tmp/parseq.tar.gz --strip-components=1 -C /opt/parseq \
    && rm /tmp/parseq.tar.gz \
    && python -m pip install --no-compile "pip>=26.2,<27" \
    && pip install --no-compile -r /opt/parseq/requirements/core.txt \
    && pip install --no-compile \
        "fastapi>=0.115,<1.0" "uvicorn>=0.32,<1.0" \
        "opencv-python-headless==4.10.0.84" "safetensors>=0.6,<1.0"
RUN python -c "import torch; torch.hub.load('/opt/parseq', 'parseq_tiny', source='local', pretrained=True)"
RUN pip install --no-compile "numpy>=1.26.4,<2.0" "onnx>=1.16,<2.0" "onnxruntime>=1.22,<2.0"
ENV TORCH_HOME=/opt/model-cache/.cache/torch
COPY ai/__init__.py ./ai/
COPY ai/readers/__init__.py ai/readers/sequence.py ai/readers/encoder_onnx.py ./ai/readers/
COPY ai/services/__init__.py ai/services/sequence_reader.py ./ai/services/
COPY ai/pipeline/__init__.py ai/pipeline/register.py ./ai/pipeline/
RUN python -c "from pathlib import Path; from ai.readers.sequence import ParseqTinyReader; from ai.readers.encoder_onnx import export_encoder; export_encoder(ParseqTinyReader(Path('/opt/parseq')), Path('/opt/parseq-encoder.onnx'))"
RUN useradd --system --uid 10001 reader \
    && chown -R reader:reader /app /opt/model-cache
USER reader
ENV READER_BACKEND=parseq
EXPOSE 8080
CMD ["uvicorn", "ai.services.sequence_reader:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
