FROM parseq_runtime
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*
COPY backend/pyproject.toml ./pyproject.toml
COPY ai/requirements.trainer.txt ./ai-requirements.txt
COPY ai/requirements.shared.txt ./requirements.shared.txt
RUN mkdir -p app && touch app/__init__.py \
    && pip install --no-compile . -r ai-requirements.txt \
    && pip install --no-compile --no-deps rapidocr-onnxruntime==1.4.4
RUN python -c "from torchvision.models import MobileNet_V3_Small_Weights; MobileNet_V3_Small_Weights.IMAGENET1K_V1.get_state_dict(progress=False, check_hash=True)"
COPY backend/app ./app
COPY ai ./ai
USER reader
CMD ["python", "-m", "ai.trainer"]
